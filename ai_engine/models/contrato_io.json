  "campos": {
    "modelo1_completar": {
      "entrada": {
        "corrientes_A": "list[float|null]  null = dato faltante",
        "dt_s": "float opcional, segundos entre muestras"
      },
      "salida": {
        "corrientes_completas_A": "list[float]",
        "imputado": "list[0|1]  1 = reconstruido",
        "potencia_W": "list[float]  P=V_BUS*I (DC)",
