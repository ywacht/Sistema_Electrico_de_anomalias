        "dt_s": "float"
      }
    },
    "modelo2_predecir": {
      "entrada": {
        "corrientes_A": "list[float] sin huecos, recientes"
      },
      "salida": {
        "i_futura_max_A": "float, máx. esperada en ~HORIZONTE pasos",
        "prob_pico": "float 0-1",
        "alerta_pico": "0|1",
        "score_anomalia": "float",
        "anomalia": "0|1"
      }
    },
    "modelo3_clasificar": {
      "entrada": {
        "textos": "list[str] bitácora (generada o escrita a mano)"
      },
      "salida": "list[{texto, nivel 1-3, predicted_severity 'Leve'|'Moderado'|'Crítico', confianza 0-1}]"
    },
    "pipeline_analizar": {
      "entrada": {
        "timestamps_s": "list[float] epoch",
        "corrientes_A": "list[float] mismo largo",
        "ts_texto": "str",
        "gracia": "bool, true justo tras reconectar la carga"
      },
      "salida": {
        "predicted_severity": "'Leve'|'Moderado'|'Crítico'  <- campo para el backend",
        "nivel": "1|2|3",
        "nombre": "str",
        "corriente": "A",
        "potencia": "W",
        "i_futura_max": "A",
        "prob_pico": "0-1",
        "anomalia": "0|1",
        "imputado": "0|1",
        "n_reconstruidos": "int",
        "confianza": "0-1",
        "regla_dura": "bool (true = corriente >= I_CRITICA, corte inmediato)",
        "texto": "bitácora",
        "energia_ventana_kwh": "float"
      }
    }
  },
