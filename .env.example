# ==============================================================================
# ECOGRID AI - ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env.example)
# Universidad Tecnológica de Calvillo (UTC) - Ingeniería en Tecnologías (7mo)
# ==============================================================================
# INSTRUCCIONES:
# 1. Este archivo (.env.example) sirve como plantilla de ejemplo y sí está en Git.
# 2. Crea un archivo llamado exactamente ".env" en la raíz del proyecto.
# 3. El archivo ".env" ESTÁ EN EL .gitignore, por lo que TUS CONTRASEÑAS Y CREDENCIALES
#    NUNCA SE SUBIRÁN A GITHUB, manteniéndose 100% privadas y seguras.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR WEB BACKEND
# ------------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
DEBUG=False

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS NO RELACIONAL EN LA NUBE (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# Estructura típica de conexión provista por MongoDB Atlas:
# mongodb+srv://<usuario>:<password>@<nombre-cluster>.xxxx.mongodb.net/?retryWrites=true&w=majority
#
# Ejemplo real para copiar en tu archivo .env:
# MONGO_URI=mongodb+srv://admin_ecogrid:MiPasswordSeguro123@ecogrid-cluster.abcde.mongodb.net/?retryWrites=true&w=majority
#
# NOTA: En MongoDB Atlas, asegúrate de:
# a) Network Access: Agregar IP "0.0.0.0/0" (Allow Access from Anywhere) para permitir conexiones de tu PC y ESP32.
# b) Database Access: Crear un usuario con rol "readWriteAnyDatabase".
MONGO_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD_AQUI@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=ecogrid_ai_db

# ------------------------------------------------------------------------------
# 3. PROTOCOLOS DE SEGURIDAD Y AUDITORÍA (SYSLOG Y SNMP)
# ------------------------------------------------------------------------------
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=514
SNMP_COMMUNITY=public
SNMP_TRAP_PORT=162
