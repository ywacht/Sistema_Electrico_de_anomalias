# Configuración del Entorno de EcoGrid AI

# Servidor Web
PORT=5000
HOST=0.0.0.0
DEBUG=False

# Base de Datos No Relacional en la Nube (MongoDB Atlas / Amazon DocumentDB)
# Dejar vacío si se desea usar el repositorio de series de tiempo local embebido
MONGO_URI=mongodb+srv://usuario:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=ecogrid_ai_db

# Seguridad Informática y Monitoreo SIEM
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=514
SNMP_COMMUNITY=public
SNMP_TRAP_PORT=162
